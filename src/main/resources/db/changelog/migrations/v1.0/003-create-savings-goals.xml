<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-savings-goals" author="finance-tracker">
        <createTable tableName="savings_goal">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="member_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_savings_member" references="member(id)"/>
            </column>
            <column name="goal_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="target_amount" type="numeric(10,2)"/>
            <column name="current_amount" type="numeric(10,2)" defaultValueNumeric="0"/>
            <column name="monthly_savings_target" type="numeric(10,2)"/>
            <column name="income" type="numeric(10,2)"/>
            <column name="target_date" type="date"/>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE"/>
            <column name="created_at" type="timestamp" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
